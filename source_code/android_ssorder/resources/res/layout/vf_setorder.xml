<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:aapt="http://schemas.android.com/aapt" android:layout_width="match_parent" android:layout_height="match_parent">
    <ScrollView android:id="@+id/scrollview" android:scrollbars="none" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_alignParentTop="true" android:isScrollContainer="true" android:overScrollMode="never">
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:weightSum="1">
            <LinearLayout android:orientation="vertical" android:id="@+id/linearLayout4" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginLeft="20dp" android:layout_marginTop="10dp" android:layout_marginRight="20dp" android:layout_marginBottom="10dp">
                <LinearLayout android:orientation="vertical" android:paddingTop="5dp" android:layout_width="match_parent" android:layout_height="match_parent">
                    <TextView android:textSize="14sp" android:textColor="#000000" android:id="@+id/textView5" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="* 고객명"/>
                    <LinearLayout android:gravity="center" android:orientation="horizontal" android:paddingTop="5dp" android:layout_width="match_parent" android:layout_height="match_parent">
                        <EditText android:theme="@style/Theme.Light" android:id="@+id/et_order_name" android:background="@drawable/round3" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginRight="10dp" android:hint="고객명" android:layout_weight="1" android:inputType="textPersonName"/>
                        <Button android:textColor="@drawable/txt_white_bg" android:id="@+id/btn_cusSearch" android:background="@drawable/corner_cell_purple" android:layout_width="wrap_content" android:layout_height="40dp" android:text="고객 찾기"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:orientation="vertical" android:paddingTop="5dp" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="10dp">
                    <TextView android:textSize="14sp" android:textColor="#000000" android:id="@+id/textView6" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="* 자택 전화번호" android:layout_weight="1"/>
                    <LinearLayout android:orientation="horizontal" android:paddingTop="5dp" android:layout_width="match_parent" android:layout_height="match_parent">
                        <EditText android:theme="@style/Theme.Light" android:id="@+id/et_order_call" android:background="@drawable/round3" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="자택 전화" android:layout_weight="1" android:inputType="phone"/>
                        <CheckBox android:id="@+id/checkBox4" android:paddingRight="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="5dp" android:text="없음"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:orientation="vertical" android:paddingTop="5dp" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="10dp">
                    <TextView android:theme="@style/Theme.Light" android:textSize="14sp" android:textColor="#000000" android:id="@+id/textView3" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="* 휴대전화" android:layout_weight="1"/>
                    <LinearLayout android:orientation="horizontal" android:paddingTop="5dp" android:layout_width="match_parent" android:layout_height="match_parent">
                        <EditText android:theme="@style/Theme.Light" android:id="@+id/et_order_phone" android:background="@drawable/round3" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="휴대전화" android:layout_weight="1" android:inputType="phone"/>
                        <CheckBox android:id="@+id/checkBox3" android:paddingRight="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="5dp" android:text="없음"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:id="@+id/linearLayout3" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginLeft="20dp" android:layout_marginRight="20dp" android:layout_below="@+id/linearLayout4">
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginBottom="3dp">
                    <TextView android:textSize="14sp" android:textColor="#000000" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="* 상품 배송지" android:layout_weight="1"/>
                    <Button android:textColor="@drawable/txt_white_bg" android:id="@+id/btn_deliverySearchBtn" android:background="@drawable/corner_cell_purple" android:paddingLeft="10dp" android:paddingRight="10dp" android:layout_width="wrap_content" android:layout_height="30dp" android:text="우편번호 조회"/>
                </LinearLayout>
                <EditText android:theme="@style/Theme.Light" android:id="@+id/et_order_delivery" android:background="@drawable/round3" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="5dp" android:hint="우편번호를 조회 해 주세요." android:ems="10" android:editable="false" android:inputType="none"/>
                <EditText android:theme="@style/Theme.Light" android:id="@+id/et_order_delivery_more" android:background="@drawable/round3" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="기타 주소" android:ems="10" android:inputType="text"/>
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:id="@+id/linearLayout2" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginLeft="20dp" android:layout_marginTop="12dp" android:layout_marginRight="20dp" android:layout_below="@+id/linearLayout3">
                <TextView android:textSize="14sp" android:textColor="#000000" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="5dp" android:text="* 자택 및 직장주소" android:layout_weight="1"/>
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginBottom="3dp">
                    <CheckBox android:id="@+id/checkBox2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="배송지와 동일" android:layout_weight="1"/>
                    <Button android:textColor="@drawable/txt_white_bg" android:id="@+id/btn_addressSearchBtn" android:background="@drawable/corner_cell_purple" android:paddingLeft="10dp" android:paddingRight="10dp" android:layout_width="wrap_content" android:layout_height="30dp" android:text="우편번호 조회"/>
                </LinearLayout>
                <EditText android:theme="@style/Theme.Light" android:id="@+id/et_order_address" android:background="@drawable/round3" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="5dp" android:hint="우편번호를 조회 해 주세요." android:ems="10" android:editable="false" android:inputType="none"/>
                <EditText android:theme="@style/Theme.Light" android:id="@+id/et_order_address_more" android:background="@drawable/round3" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="기타 주소" android:ems="10" android:layout_weight="1" android:inputType="text"/>
            </LinearLayout>
            <RelativeLayout android:id="@+id/rl_prod" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginLeft="20dp" android:layout_marginTop="20dp" android:layout_marginRight="20dp" android:layout_marginBottom="10dp">
                <TextView android:textSize="14sp" android:textColor="#000000" android:id="@+id/textView4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="5dp" android:text="* 제품 주문"/>
                <kr.microlivire.ssorder.CustomListView android:id="@+id/addedProductListView" android:background="#00ffffff" android:layout_width="match_parent" android:layout_height="wrap_content" android:divider="@null" android:dividerHeight="0dp" android:layout_below="@+id/textView4" android:layout_alignParentLeft="true"/>
                <Button android:textColor="@drawable/txt_white_bg" android:id="@+id/btn_addProduct" android:background="@drawable/corner_cell_purple" android:layout_width="wrap_content" android:layout_height="40dp" android:text="+ 제품 추가" android:layout_below="@+id/addedProductListView" android:layout_alignParentLeft="true" android:layout_alignParentRight="true"/>
            </RelativeLayout>
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginLeft="20dp" android:layout_marginTop="20dp" android:layout_marginRight="20dp" android:layout_weight="0.25">
                <TextView android:theme="@style/Theme.Light" android:textSize="14sp" android:textColor="#000000" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="3dp" android:text="비고"/>
                <EditText android:theme="@style/Theme.Light" android:id="@+id/et_etc" android:background="@drawable/round3" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:ems="10" android:inputType="text"/>
            </LinearLayout>
            <Button android:textColor="@drawable/txt_black_bg" android:id="@+id/btn_order" android:background="@drawable/corner_cell_yellow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="20dp" android:layout_marginTop="20dp" android:layout_marginRight="20dp" android:layout_marginBottom="10dp" android:text="주문완료" android:layout_below="@+id/rl_prod"/>
            <Button android:textColor="@drawable/txt_white_bg" android:id="@+id/btn_reset" android:background="@drawable/corner_cell_red" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="20dp" android:layout_marginRight="20dp" android:layout_marginBottom="20dp" android:text="주문 초기화" android:layout_below="@+id/btn_order"/>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
