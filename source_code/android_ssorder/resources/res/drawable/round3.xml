<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:aapt="http://schemas.android.com/aapt">
    <item android:state_focused="true" android:state_pressed="true">
        <shape>
            <solid android:color="#dcffffff"/>
            <stroke android:width="0.7dp" android:color="@color/DimDarkGray"/>
            <corners android:radius="5dp"/>
        </shape>
    </item>
    <item android:state_focused="false" android:state_pressed="true">
        <shape>
            <solid android:color="#dcffffff"/>
            <stroke android:width="0.7dp" android:color="@color/Gray"/>
            <corners android:radius="5dp"/>
        </shape>
    </item>
    <item android:state_focused="true" android:state_pressed="false">
        <shape>
            <solid android:color="#dcffffff"/>
            <stroke android:width="0.7dp" android:color="@color/DarkGray"/>
            <corners android:radius="5dp"/>
        </shape>
    </item>
    <item android:state_focused="false" android:state_pressed="false">
        <shape>
            <solid android:color="#dcffffff"/>
            <stroke android:width="0.7dp" android:color="#bdbdbd"/>
            <corners android:radius="5dp"/>
        </shape>
    </item>
    <item android:state_enabled="true">
        <shape>
            <padding android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp"/>
        </shape>
    </item>
</selector>
